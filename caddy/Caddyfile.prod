# Production reverse proxy for Cairn. Automatic TLS via ACME (cert persists
# in the caddy_data volume), security headers, and the path routing that
# fronts the self-hosted stack. The response-side cookie plant lives in the
# auth-proxy; Caddy handles the request-side cookie->bearer translation for
# the data plane (PostgREST + sidecar writes) and routes /auth to the proxy.
#
# Prefix-stripping is asymmetric and deliberate:
#   /api/*      strip /api  (PostgREST expects the bare path; mirrors dev Vite)
#   /auth/*     NO strip     (the auth-proxy routes on the full /auth/... path,
#                             and the SPA's /auth pages need it too)
#   /avatars*   writes: NO strip (sidecar routes on the /avatars prefix)
#               reads:  strip /avatars (file_server serves from the volume root)

# Caddy writes no access log (no `log` directive below), but it still logs an
# error line, request included, for every 5xx it generates itself — an upstream
# that is down or restarting, which is every redeploy. Strip the client address,
# the headers and the query string from those lines so no IP address or row
# value reaches the log (docs/logging.md).
{
	log default {
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>uri regexp \?.*$ ""
			}
		}
	}
}

cairn.{$DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	# Data plane: /api/* -> PostgREST, prefix stripped. The short-lived access
	# cookie (not the durable refresh-token cookie) is translated into the
	# Authorization: Bearer header PostgREST expects. The cookie carries the
	# __Host- prefix in prod (Secure + Path=/ + no Domain); the auth-proxy plants
	# that exact name (see auth-proxy/src/lib/cookies.ts).
	handle_path /api/* {
		@cookie header_regexp token Cookie __Host-cairn_access=([^;]+)
		request_header @cookie Authorization "Bearer {http.regexp.token.1}"
		reverse_proxy postgrest:3000
	}

	# Auth plane, split on method: every BFF endpoint is a POST and every SPA
	# /auth page is a GET, so GET/HEAD goes to `web` (whose index.html fallback
	# lets the SPA route it) and everything else goes to the auth-proxy, prefix
	# intact. The auth-proxy owns the list of BFF endpoints and answers anything
	# else with a 404 — it forwards nothing to GoTrue verbatim — so Caddy keeps no
	# path list at all, and prod answers each /auth request as the dev mirror in
	# web/vite.config.ts does.
	@auth path /auth /auth/*
	handle @auth {
		@auth_pages method GET HEAD
		handle @auth_pages {
			reverse_proxy web:80
		}
		# The auth-proxy's rate limiter keys per-IP off X-Real-IP ONLY (it ignores
		# the spoofable X-Forwarded-For). Caddy does not set X-Real-IP by default,
		# so set it here to the real socket peer — Caddy OVERWRITES any
		# client-supplied value, which both gives the limiter a true client IP and
		# closes the spoof. Without this, X-Real-IP is absent and clientIp() falls
		# back to Caddy's container IP, collapsing every client into one shared
		# bucket. See auth-proxy/src/lib/rate-limit.ts.
		handle {
			reverse_proxy auth-proxy:3002 {
				header_up X-Real-IP {remote_host}
			}
		}
	}

	# Avatar writes -> sidecar, prefix preserved (the sidecar routes on
	# /avatars). Same cookie->bearer translation as the data plane.
	@avatar_writes {
		method POST DELETE
		path /avatars*
	}
	handle @avatar_writes {
		@avatar_cookie header_regexp token Cookie __Host-cairn_access=([^;]+)
		request_header @avatar_cookie Authorization "Bearer {http.regexp.token.1}"
		reverse_proxy sidecar:3001
	}

	# Avatar reads -> file_server from the volume, prefix stripped, far-future
	# immutable caching (avatar_version is the cache buster).
	handle_path /avatars/* {
		root * /srv/cairn/avatars
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# Everything else (the SPA) -> the web container.
	handle {
		reverse_proxy web:80
	}
}

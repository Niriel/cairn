{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: compose up",
      "type": "shell",
      "command": "docker compose up -d",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "backend: migrate",
      "type": "shell",
      "command": "./scripts/migrate.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["backend: compose up"],
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "web: dev",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}/web" },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*(ready in|Local:).*"
        }
      }
    },
    {
      "label": "dev: start all",
      "dependsOn": ["backend: migrate", "web: dev"],
      "dependsOrder": "sequence",
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "never" },
      "problemMatcher": []
    },
    {
      "label": "backend: seed",
      "type": "shell",
      "command": "./scripts/seed.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "backend: smoke",
      "type": "shell",
      "command": "./scripts/smoke.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "backend: compose down",
      "type": "shell",
      "command": "docker compose down",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "backend: reset (down -v + up + migrate + seed)",
      "type": "shell",
      "command": "docker compose down -v && docker compose up -d && ./scripts/migrate.sh && ./scripts/seed.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "logs: backend",
      "type": "shell",
      "command": "docker compose logs -f",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}

{
	"version": "0.2",
	"language": "en-GB,en",
	"ignorePaths": [
		"node_modules/**",
		"**/node_modules/**",
		".svelte-kit/**",
		"**/.svelte-kit/**",
		"build/**",
		"dist/**",
		"coverage/**",
		"playwright-report/**",
		"test-results/**",
		"pnpm-lock.yaml",
		"package-lock.json",
		"*.min.js",
		"*.min.css",
		".git/**"
	],
	// cspell parses this file as JSONC — `//` comments are fine. Sections
	// below are organised loosely by *what kind of word* it is, so when a
	// new entry needs adding it's clear where it belongs (and obvious if
	// an entry is already covered under a different casing).
	"words": [
		// Real English / domain words that cspell's en-GB dictionary doesn't
		// know but that we use as ordinary prose.
		"dockerized",
		"Impressum",
		"lifecycles",
		"onboarding",
		"tabletop",

		// Developer slang and jargon — common in code comments and docs but
		// not in any English dictionary.
		"footgun",
		"hasnt",
		"hyperscaler",
		"hyperscalers",
		"subshell",
		"unrunnable",
		"unstub",
		"unwirable",
		"upsert",
		"upserts",
		"upvotes",

		// Tech acronyms and protocol names.
		"ACME",
		"CRDT",
		"DDG",
		"DKIM",
		"DSN",
		"HMR",
		"HSTS",
		"JWT",
		"JWTs",
		"OAuth",
		"OIDC",
		"OWASP",
		"PWA",
		"PWAs",
		"Referer",
		"RLS",
		"SMTP",
		"SPF",
		"SSO",
		"STARTTLS",
		"TLS",
		"UUIDs",
		"VPS",

		// Brand and project names — products and services Cairn integrates
		// with, plus Cairn itself.
		"Apple's",
		"Brave",
		"Cairn",
		"Cairn's",
		"DBeaver",
		"Forgejo",
		"Gandi",
		"GoTrue",
		"GoTrue's",
		"Hetzner",
		"Hetzner's",
		"Postico",
		"Postmark",
		"Supabase",
		"TablePlus",

		// Tools, libraries, package names, and system binaries we install,
		// run, or invoke. Lowercase / mixed-case entries appear separately
		// when both forms turn up (e.g. import vs prose).
		"Automerge",
		"BMFF",
		"Caddy",
		"Caddy's",
		"Caddyfile",
		"corepack",
		"xcaddy",
		"Corepack",
		"gotrue",
		// gstreamer + libav: GStreamer media framework and FFmpeg's libav*
		// libraries; Playwright/WebKit needs them at runtime on Linux.
		"gstreamer",
		"libav",
		"happydom",
		"jsdom",
		"lefthook",
		"libtap",
		"mailpit",
		"Mailpit",
		"msw",
		"pgcrypto",
		"pgtap",
		"pgTAP",
		"plpgsql",
		"Plpgsql",
		"pnpm",
		"postgres",
		"Postgres",
		"postgresql",
		"PostgreSQL",
		"postgrest",
		"PostgREST",
		"psql",
		"restic",
		"Restic",
		"shellcheck",
		"ShellCheck",
		"shfmt",
		"sqitch",
		"Sqitch",
		"sqlfluff",
		"supabase",
		"svelte",
		"Svelte",
		"sveltekit",
		"SvelteKit",
		"vite",
		"Vite",
		"vitest",
		"Vitest",
		"winget",
		"Yjs",

		// Code identifiers, config keys, file tokens, and shell flags that
		// show up in literals across the repo.
		"EXDEV",
		"ftyp",
		"healthz",
		"libheif",
		"libwebp",
		"plpython",
		"editorconfig",
		"envconfig",
		"magiclink",
		"noqa",
		"onaction",
		"oncollapse",
		"ondismiss",
		"onexpand",
		"pipefail",
		"pipx",
		"sourcehandler",
		"tmpfs",
		"tsbuildinfo",

		// VS Code extension publisher IDs — appear in
		// `.vscode/extensions.json` recommendations.
		"dbaeumer",
		"dorzey",
		"esbenp",
		"evilmartians",
		"foxundermoon",
		"koalaman",
		"streetsidesoftware",
		"timonwong"
	],
	"flagWords": [],
	"allowCompoundWords": true
}

# Local dev secrets. Copy to `.env` (gitignored) before `docker compose up`.
# In production these are stronger random strings stored on the server.

POSTGRES_PASSWORD=devpassword
AUTHENTICATOR_PASSWORD=devauth
GOTRUE_PASSWORD=devgotrue

# Shared between PostgREST (verifies) and GoTrue (signs). 32+ chars.
JWT_SECRET=dev-jwt-secret-please-change-me-to-32-or-more-chars

# scripts/migrate.sh polls for auth.users for migrations numbered 0004+
# (GoTrue creates it on first connection). Default 60s; bump if your
# machine is slow to start GoTrue (cold CI, throttled VPS).
# MIGRATE_AUTH_USERS_TIMEOUT=60

# Production secrets template. Copy to `.env.prod` on the VPS (gitignored)
# and fill in. The prod stack is invoked with:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod ...
#
# Generate each secret with: openssl rand -hex 32
# Store the completed .env.prod in a password manager — it is never committed
# and the only copy lives on the box.

# Postgres superuser (role: cairn) — used by scripts/migrate.sh.
POSTGRES_PASSWORD=

# Postgres role PostgREST connects as — no rights of its own; SET ROLEs to
# anon or authenticated per request based on the JWT.
AUTHENTICATOR_PASSWORD=

# Postgres role GoTrue connects as — owns the auth schema.
GOTRUE_PASSWORD=

# Shared between PostgREST (verifies) and GoTrue (signs). Must be >= 32 bytes
# and IDENTICAL for both services, or token verification fails.
JWT_SECRET=

# Public hostname. Caddy serves cairn.${DOMAIN} and obtains its TLS cert for
# that name via ACME; GoTrue's site/callback URLs are derived from it.
DOMAIN=lynnscape.eu

# Outbound SMTP for magic-link e-mail (GoTrue).
SMTP_HOST=mail.gandi.net
SMTP_PORT=587
SMTP_USER=no-reply@lynnscape.eu
SMTP_PASS=
SMTP_FROM=no-reply@lynnscape.eu

# Signup gate (GoTrue setting — note the double negative). `false` = OPEN
# signup: anyone with the URL can request a magic link and get an account.
# Cairn is a live alpha meant to be used, so keep this `false` — real users
# need to be able to sign themselves up. The prod compose defaults this to
# `true` (invite-only) ONLY as a fail-closed guard for when the variable is
# missing — that default is a safety net, not a recommendation to flip it.
# Set it to `true` only if open signup ever invites e-mail abuse.
DISABLE_SIGNUP=false

# scripts/migrate.sh polls for auth.users for migrations numbered 0004+
# (GoTrue creates it on first connection). Default 60s; bump on a slow or
# throttled VPS where GoTrue is slow to start.
# MIGRATE_AUTH_USERS_TIMEOUT=120
